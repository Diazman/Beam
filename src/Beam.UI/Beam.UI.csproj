<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Beam's user interface shared by every host: view models, views, dialogs, styles and translations.
    Hosts: Beam.App (Windows/Linux desktop) and, later, Beam.Android. Namespaces stay Beam.App.* so the code
    reads the same in every project.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Beam.App</RootNamespace>
    <AssemblyName>Beam.UI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Beam" />
    <InternalsVisibleTo Include="Beam.App.Tests" />
  </ItemGroup>

</Project>
