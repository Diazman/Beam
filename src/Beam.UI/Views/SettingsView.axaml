<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             x:Class="Beam.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{l:T 'Settings'}" />
        <TextBlock Classes="secondary" Text="{l:T 'Changes are saved automatically.'}" />
      </StackPanel>

      <!-- This computer -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{Binding ThisDeviceTitle}" />
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{l:T 'Name'}" />
              <TextBlock Classes="caption" Text="{l:T 'Other people see this name when they send you files.'}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <TextBox Name="NameBox" Classes="nameBox" Text="{Binding DeviceName}" MaxLength="{Binding MaxNameLength}"
                         Watermark="{l:T 'e.g. Diaz\'s laptop'}" />
                <Button Content="{l:T 'Save'}" Command="{Binding SaveNameCommand}" />
              </StackPanel>
              <TextBlock Classes="caption success" Text="{Binding NameStatus}" />
            </StackPanel>
            <Separator />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Let nearby devices find this computer', Phone='Let nearby devices find this phone'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{l:T 'When off, this computer doesn\'t appear for others. You can still send files to them.', Phone='When off, this phone doesn\'t appear for others. You can still send files to them.'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Discoverable}" Margin="16,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Trusted devices -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Trusted devices'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'Trusted devices send each other files without asking, and can ask to browse each other\'s shared folders. Add one with a code, or by ticking “Always accept” when it sends you files.'}" />
            <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{l:T 'No trusted devices. Beam always asks before receiving files.'}" IsVisible="{Binding !HasTrustedDevices}" />
            <ItemsControl ItemsSource="{Binding TrustedDevices}" IsVisible="{Binding HasTrustedDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrustedDeviceViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                    <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" IsVisible="{Binding AlwaysBrowse}">
                        <TextBlock Classes="caption" Text="{l:T 'Browses without asking'}" VerticalAlignment="Center" />
                        <Button Classes="link" Content="{l:T 'Ask again'}" Command="{Binding AskAgainCommand}" FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{l:T 'Browse'}" Command="{Binding BrowseCommand}" Margin="0,2,8,2" />
                      <Button Content="{l:T 'Remove'}" Command="{Binding RemoveCommand}" Margin="0,2" />
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="{l:T 'Add a trusted device…'}" Command="{Binding AddTrustedCommand}" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAddingTrusted}" Width="80" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Browsing: what trusted devices may see here -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Browsing'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Let trusted devices browse my shared folders'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{l:T 'You are asked each time, unless you always allow a device. Only the folders below can be seen, over your Wi-Fi or a direct connection, encrypted.'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding BrowsingEnabled}" Margin="16,0,0,0" />
            </Grid>
            <StackPanel Spacing="12" IsVisible="{Binding BrowsingEnabled}">
              <Separator />
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="{l:T 'Shared folders'}" />
                <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{l:T 'No folders are shared. Trusted devices see nothing.'}" IsVisible="{Binding !HasSharedFolders}" />
                <ItemsControl ItemsSource="{Binding SharedFolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SharedFolderViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{l:T 'Remove'}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{l:T 'Share a folder…'}" Command="{Binding AddSharedFolderCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <Separator />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="h3" Text="{l:T 'Allow adding files'}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:T 'Trusted devices can put files into the shared folders. Nothing is ever replaced, changed or deleted.'}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BrowseAllowAdding}" Margin="16,0,0,0" />
              </Grid>
            </StackPanel>
            <Border Classes="notice error" IsVisible="{Binding HasTrustMessage}">
              <TextBlock Text="{Binding TrustMessage}" TextWrapping="Wrap" FontSize="13" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Backup -->
      <StackPanel Spacing="10" IsVisible="{Binding Backup.IsAvailable}">
        <TextBlock Classes="h2" Text="{l:T 'Backup'}" />

        <!-- The computer: phones that back up here -->
        <Border Classes="card" IsVisible="{Binding Backup.IsComputer}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{l:T 'Back up phones to this computer'}" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'A phone you add backs up its photos, videos or folders here by itself whenever it is on the same Wi-Fi. Only phones you add can back up here.'}" />
              <Button Classes="accent" Content="{l:T 'Add a phone…'}" Command="{Binding Backup.AddPhoneCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding Backup.HasPartners}">
              <Separator />
              <ItemsControl ItemsSource="{Binding Backup.Partners}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupPartnerViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                      <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
                      <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="caption" Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{l:T 'Open folder'}" Command="{Binding OpenCommand}" />
                        <Button Content="{l:T 'Remove'}" Command="{Binding RemoveCommand}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Separator />
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{l:T 'Save backups to'}" />
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Backup.BackupFolder}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Backup.BackupFolder}" VerticalAlignment="Center" />
              </Grid>
              <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{l:T 'Change…'}" Command="{Binding Backup.ChangeFolderCommand}" Margin="0,0,8,6" />
                <Button Content="{l:T 'Open folder'}" Command="{Binding Backup.OpenFolderCommand}" Margin="0,0,8,6" />
              </WrapPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'Each phone gets its own folder here. Nothing is deleted here when it is deleted on the phone.'}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The phone: not set up yet -->
        <Border Classes="card" IsVisible="{Binding Backup.IsPhone}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="8" IsVisible="{Binding Backup.HasNoPlan}">
              <TextBlock Classes="h3" Text="{l:T 'Back up this phone to your computer'}" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'Your photos, videos or folders are backed up to your computer by themselves whenever both are on the same Wi-Fi. On the computer, open Beam → Settings → Backup → Add a phone, then scan the code shown there.'}" />
              <Button Classes="accent" Content="{l:T 'Set up backup'}" Command="{Binding Backup.SetUpCommand}" HorizontalAlignment="Left" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Backup.IsBusy}" />
            </StackPanel>

            <!-- Set up: what is backed up, and how it went -->
            <StackPanel Spacing="12" IsVisible="{Binding Backup.HasPlan}">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{Binding Backup.TargetText}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Backup.StatusText}" />
              </StackPanel>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Backup.IsRunning}" />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="h3" Text="{l:T 'Back up automatically'}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:T 'Whenever this phone and the computer are on the same Wi-Fi. Mobile data is never used.'}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Backup.Automatic}" Margin="16,0,0,0" />
              </Grid>
              <Separator />
              <TextBlock Classes="h3" Text="{l:T 'What is backed up'}" />
              <!-- From the whole phone: a switch each, and "Choose folders" (closed at first) -->
              <ItemsControl ItemsSource="{Binding Backup.WholePhoneKinds}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WholePhoneViewModel">
                    <StackPanel Spacing="6" Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Title}" />
                          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Caption}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" Margin="16,0,0,0" AutomationProperties.Name="{Binding Title}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOn}" Margin="16,0,0,0">
                        <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="link" Content="{Binding FoldersButtonText}" Command="{Binding ToggleFoldersCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                      <StackPanel Spacing="2" Margin="16,0,0,0">
                        <StackPanel.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsOn" />
                            <Binding Path="ShowsFolders" />
                          </MultiBinding>
                        </StackPanel.IsVisible>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                        <TextBlock Classes="caption error" TextWrapping="Wrap" Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" />
                        <CheckBox IsChecked="{Binding AllFolders}" MinHeight="32" IsVisible="{Binding !IsLoading}">
                          <TextBlock Text="{l:T 'All folders'}" FontWeight="SemiBold" />
                        </CheckBox>
                        <ItemsControl ItemsSource="{Binding Folders}" Margin="24,0,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderChoiceViewModel">
                              <StackPanel>
                              <Grid ColumnDefinitions="*,Auto">
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}" MinHeight="32" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                  <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="190"
                                               ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Details}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Grid.Column="2" Classes="badge" IsVisible="{Binding IsNew}" VerticalAlignment="Center" Margin="6,0,0,0">
                                      <TextBlock Text="{l:T 'New'}" FontSize="11" />
                                    </Border>
                                  </Grid>
                                </CheckBox>
                                <Button Grid.Column="1" Classes="link" Content="{Binding ChildrenButtonText}" Command="{Binding ToggleChildrenCommand}"
                                        IsVisible="{Binding IsOther}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              </Grid>
                                <!-- "Other folders" opened: each of them -->
                                <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding ShowsChildren}" Margin="24,0,0,0">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderChoiceViewModel">
                                      <Grid ColumnDefinitions="*,Auto">
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}" MinHeight="32" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                  <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="190"
                                               ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Details}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Grid.Column="2" Classes="badge" IsVisible="{Binding IsNew}" VerticalAlignment="Center" Margin="6,0,0,0">
                                      <TextBlock Text="{l:T 'New'}" FontSize="11" />
                                    </Border>
                                  </Grid>
                                </CheckBox>
                                <Button Grid.Column="1" Classes="link" Content="{Binding ChildrenButtonText}" Command="{Binding ToggleChildrenCommand}"
                                        IsVisible="{Binding IsOther}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Separator />
              <!-- Folders chosen one by one: a switch each, and the kinds of files to take from it -->
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Folders'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T 'Back up chosen kinds of files from one folder.'}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Backup.Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupSourceViewModel">
                    <StackPanel Spacing="6" Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Details}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center"
                                      Margin="12,0,0,0" AutomationProperties.Name="{Binding Title}" />
                        <Button Grid.Column="2" Content="{l:T 'Remove'}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                      <!-- A folder: which kinds of its files. Closed: what is chosen, and a button to change it. Open: a
                           checkbox each (the documents under "Documents", "Other" last), indented under the folder. -->
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsFolder}" Margin="16,0,0,0">
                        <TextBlock Classes="caption" Text="{Binding KindsSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="link" Content="{Binding KindsButtonText}" Command="{Binding ToggleKindsCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                      <CheckBox IsChecked="{Binding AllTypes}" IsVisible="{Binding ShowsKinds}" Margin="16,0,0,0" MinHeight="32">
                        <TextBlock Text="{l:T 'All file types'}" FontWeight="SemiBold" />
                      </CheckBox>
                      <ItemsControl ItemsSource="{Binding FileKinds}" IsVisible="{Binding ShowsKinds}" Margin="16,0,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FileKindViewModel">
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}" Classes.child="{Binding IsChild}" MinHeight="32">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Classes="caption" Text="{Binding Details}" IsVisible="{Binding HasDetails}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption error" TextWrapping="Wrap" IsVisible="{Binding HasNoKinds}" Margin="16,0,0,0"
                                 Text="{l:T 'Nothing is backed up from this folder. Tick at least one kind of file.'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{l:T 'Add a folder…'}" Command="{Binding Backup.AddFolderCommand}" HorizontalAlignment="Left" />
              <Separator />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="h3" Text="{l:T 'Keep the phone\'s folder names'}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:T 'Off: files are sorted on the computer into Photos, Videos, Documents and other folders by kind. On: they keep the folders they are in on this phone.'}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Backup.KeepFolderNames}" Margin="16,0,0,0" />
              </Grid>
              <Separator />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="accent" Content="{l:T 'Back up now'}" Command="{Binding Backup.BackUpNowCommand}" Margin="0,0,8,6" />
                <Button Content="{l:T 'Stop backup'}" Command="{Binding Backup.StopCommand}" Margin="0,0,8,6" />
              </WrapPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'Files go only to this computer, encrypted, over your Wi-Fi. Nothing is deleted on the computer when you delete it here.'}" />
            </StackPanel>

            <Border Classes="notice error" IsVisible="{Binding Backup.HasMessage}">
              <TextBlock Text="{Binding Backup.Message}" TextWrapping="Wrap" FontSize="13" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Receiving -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Receiving files'}" />
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{l:T 'Save received files to'}" />
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ReceiveFolder}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ReceiveFolder}" VerticalAlignment="Center" />
              </Grid>
              <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{l:T 'Change…'}" Command="{Binding ChangeFolderCommand}" Margin="0,0,8,6" />
                <Button Content="{l:T 'Open folder'}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,6" />
                <Button Classes="link" Content="{l:T 'Use Downloads', Phone='Use Download/Beam'}" Command="{Binding ResetFolderCommand}"
                        IsVisible="{Binding !UsesDefaultFolder}" Margin="0,0,0,6" VerticalAlignment="Center" />
              </WrapPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding IsDesktop}"
                         Text="{l:T 'You can also choose a different folder each time you accept files.'}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- App behaviour -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'App'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto" IsVisible="{Binding SupportsStartup}">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Start Beam when I sign in to Windows'}" />
                <TextBlock Classes="caption" Text="{l:T 'Beam starts quietly in the notification area, ready to receive files.'}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" Margin="16,0,0,0" />
            </Grid>
            <Separator IsVisible="{Binding SupportsStartup}" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto" IsVisible="{Binding IsDesktop}">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Keep running when the window is closed'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{l:T 'Beam stays in the notification area so other computers can still send you files.'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" Margin="16,0,0,0" />
            </Grid>
            <Separator IsVisible="{Binding IsDesktop}" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Appearance'}" />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                        MinWidth="200" Margin="16,0,0,0" />
            </Grid>
            <Separator />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Language'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding LanguageNeedsRestart}"
                           Text="{l:T 'Restart Beam to use the new language.'}" />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                        MinWidth="200" Margin="16,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Notifications -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Notifications'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="{l:T 'Show notifications'}" />
                <TextBlock Classes="caption" Text="{l:T 'Only shown while the Beam window isn\'t in front.', Phone='Only shown while Beam isn\'t open.'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" Margin="16,0,0,0" />
            </Grid>
            <StackPanel Spacing="4" Margin="2,0,0,0" IsEnabled="{Binding NotificationsEnabled}">
              <CheckBox Content="{l:T 'When someone wants to send me files'}" IsChecked="{Binding NotifyOnIncomingRequest}" />
              <CheckBox Content="{l:T 'When a transfer finishes or fails'}" IsChecked="{Binding NotifyOnTransferFinished}" />
              <CheckBox Content="{l:T 'When a nearby device appears'}" IsChecked="{Binding NotifyOnDeviceFound}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Connection help -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Connection'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="h3" Text="{l:T 'This computer\'s address', Phone='This phone\'s address'}" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'If another device can\'t find this computer automatically, type this address there using “Can\'t find a device?”.', Phone='If a computer can\'t find this phone automatically, type this address there using “Can\'t find a device?”.'}" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <SelectableTextBlock Text="{Binding LocalAddresses}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{l:T 'Copy'}" Command="{Binding CopyAddressCommand}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasManualAddresses}">
              <Separator />
              <TextBlock Classes="h3" Text="{l:T 'Devices added by address'}" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding ManualAddresses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ManualAddressViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <TextBlock Text="{Binding Address}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{l:T 'Forget'}" Command="{Binding RemoveCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- About -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'About'}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding VersionText}" />
            <TextBlock Classes="caption" TextWrapping="Wrap">
              <Run Text="{l:T 'Security code of this computer:', Phone='Security code of this phone:'}" />
              <Run Text="{Binding SecurityCode}" FontWeight="SemiBold" />
              <Run Text="{l:T ' — shown to others when you send them files, so they can check it\'s really you.'}" />
            </TextBlock>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'Transfers between devices with the Beam app go directly between them, are encrypted, and every file is checked after it arrives. Nothing goes through the internet.'}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:T 'Open log folder', Phone='Send log'}" Command="{Binding OpenLogsCommand}"
                      ToolTip.Tip="{l:T 'Technical details that help when troubleshooting'}" />
              <Button Classes="link" Content="{l:T 'Privacy policy'}" Command="{Binding OpenPrivacyCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
