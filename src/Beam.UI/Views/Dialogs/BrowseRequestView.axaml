<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.BrowseRequestView"
             x:DataType="dlg:BrowseRequestViewModel"
             Classes="dialogBody w420">
  <StackPanel Spacing="14">
    <Border Classes="iconBadge" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Left">
      <PathIcon Data="{StaticResource IconFolder}" Width="22" Height="22" />
    </Border>
    <TextBlock Classes="dialogTitle" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
    <Border Classes="details">
      <StackPanel Spacing="4">
        <TextBlock Classes="caption" Text="{Binding FoldersText}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding SecurityText}" />
      </StackPanel>
    </Border>
    <CheckBox IsChecked="{Binding Always}">
      <TextBlock Text="{Binding AlwaysText}" TextWrapping="Wrap" />
    </CheckBox>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{l:T 'Don\'t allow'}" MinWidth="96" Command="{Binding DenyCommand}" />
      <Button Classes="accent" Content="{l:T 'Allow'}" MinWidth="96" Command="{Binding AllowCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
