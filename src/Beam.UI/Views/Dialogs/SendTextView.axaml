<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.SendTextView"
             x:DataType="dlg:SendTextViewModel"
             Classes="dialogBody w480">
  <StackPanel Spacing="14">
    <TextBlock Classes="dialogTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{l:T 'Type or paste a message, a link, a code or an address. It arrives in seconds.'}" />
    <TextBox Name="TextBox" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Height="140"
             Watermark="{l:T 'e.g. https://… or the Wi-Fi password'}" />
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Classes="link" Content="{l:T 'Paste from clipboard'}" Command="{Binding PasteCommand}" Padding="0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="{l:T 'Cancel'}" MinWidth="96" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="{l:T 'Send'}" MinWidth="96" Command="{Binding SendCommand}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
