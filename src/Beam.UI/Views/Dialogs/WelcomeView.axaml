<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.WelcomeView"
             x:DataType="dlg:WelcomeViewModel"
             Classes="dialogBody w480">
  <StackPanel Spacing="18">
    <Image Source="/Assets/beam.png" Width="64" Height="64" HorizontalAlignment="Left" />
    <StackPanel Spacing="8">
      <TextBlock Classes="dialogTitle" FontSize="24" Text="{l:T 'Welcome to Beam'}" />
      <TextBlock Classes="secondary" FontSize="15" TextWrapping="Wrap"
                 Text="{l:T 'Send files directly between your computers and phones nearby. Open Beam on both, pick a device, and drop in your files.', Phone='Send files between this phone and nearby computers. Open Beam on both, pick a computer and choose your files.'}" />
    </StackPanel>

    <!-- How it works, in three lines: the three places a new user needs. -->
    <Border Classes="details" Padding="14,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="iconBadge brand" Width="28" Height="28" CornerRadius="14">
            <PathIcon Data="{StaticResource IconSend}" Width="12" Height="12" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{l:T 'Send: drop in files, pick a device, press Send.'}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="iconBadge brand" Width="28" Height="28" CornerRadius="14">
            <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{l:T 'Receive: keep Beam open; you are asked before anything arrives.'}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="iconBadge brand" Width="28" Height="28" CornerRadius="14">
            <PathIcon Data="{StaticResource IconDevices}" Width="12" Height="12" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{l:T 'Devices: the ones nearby and the ones you trust.'}" />
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Spacing="6">
      <TextBlock Classes="h3" Text="{l:T 'Name this computer', Phone='Name this phone'}" />
      <TextBox Name="NameBox" Text="{Binding DeviceName}" MaxLength="{Binding MaxNameLength}" Watermark="{l:T 'e.g. Diaz\'s PC', Phone='e.g. Diaz\'s phone'}" />
      <TextBlock Classes="caption" Text="{l:T 'This is the name other people see. You can change it later in Settings.'}" />
    </StackPanel>

    <Border Classes="notice" IsVisible="{Binding ShowFirewallNote}">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="13"
                   Text="{l:T 'Windows may ask whether Beam can use your network. Choose Allow so nearby devices can find this computer.'}" />
      </Grid>
    </Border>

    <Button Classes="accent large" Content="{l:T 'Get started'}" HorizontalAlignment="Right" Command="{Binding StartCommand}" IsDefault="True" />
  </StackPanel>
</UserControl>
