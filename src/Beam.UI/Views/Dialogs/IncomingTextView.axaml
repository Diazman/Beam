<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.IncomingTextView"
             x:DataType="dlg:IncomingTextViewModel"
             Width="480">
  <StackPanel Spacing="14">
    <TextBlock Classes="dialogTitle" Text="{Binding Title}" TextWrapping="Wrap" />
    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" Padding="12" MaxHeight="260">
      <ScrollViewer>
        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{l:T 'Copy'}" MinWidth="80" Command="{Binding CopyCommand}" />
        <TextBlock Classes="caption success" Text="{Binding CopyStatus}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="{l:T 'Close'}" MinWidth="96" Command="{Binding CloseCommand}" />
        <Button Classes="accent" Content="{l:T 'Open link'}" MinWidth="96" Command="{Binding OpenLinkCommand}" IsVisible="{Binding HasLink}" />
      </StackPanel>
    </Grid>
    <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasLink}"
               Text="{l:T 'Only open links from people you trust.'}" />
  </StackPanel>
</UserControl>
