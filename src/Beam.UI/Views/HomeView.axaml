<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Beam.App.ViewModels"
             xmlns:l="using:Beam.App.Localization"
             x:Class="Beam.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Classes="page" Spacing="28">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="{l:T 'Send files'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:T 'Send files and folders directly to a nearby computer. No cables, accounts, or internet needed.', Phone='Send files directly to a nearby computer. No cables, accounts, or internet needed.'}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="chip nameChip" VerticalAlignment="Top" Margin="16,2,0,0"
                  Command="{Binding EditNameCommand}"
                  ToolTip.Tip="{Binding VisibilityText}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDiscoverable}" />
                <Ellipse Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding !IsDiscoverable}" />
              </Panel>
              <TextBlock Classes="caption" Text="{l:T 'This computer:'}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LocalDeviceName}" FontWeight="SemiBold" VerticalAlignment="Center"
                         MaxWidth="200" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Step 1: nearby computers -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Nearby computers'}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="link" Content="{l:T 'Can\'t find a computer?'}"
                    Command="{Binding ConnectByAddressCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding ScanCodeCommand}" IsVisible="{Binding CanScanCodes}"
                    ToolTip.Tip="{l:T 'Scan a computer\'s code to pair with it'}" Margin="4,0,0,0">
              <PathIcon Data="{StaticResource IconQr}" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{l:T 'Look for nearby computers again'}" Margin="4,0,0,0">
              <PathIcon Data="{StaticResource IconRefresh}" />
            </Button>
          </Grid>

          <TextBlock Classes="caption" Text="{Binding DeviceHint}" IsVisible="{Binding HasDeviceHint}" Margin="0,-4,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowMultiSendUpsell}" Margin="0,-4,0,0">
            <TextBlock Classes="caption" Text="{l:T 'Want to send to several computers at once?'}" VerticalAlignment="Center" />
            <Button Classes="link" Content="{l:T 'Get Beam Pro'}" Command="{Binding UpgradeCommand}" Padding="0" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>

          <Border Classes="notice warning" IsVisible="{Binding DiscoveryUnavailable}">
            <TextBlock Text="{Binding DiscoveryProblem}" TextWrapping="Wrap" />
          </Border>

          <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding HasDevices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceViewModel">
                <Button Classes="device" Classes.selected="{Binding IsSelected}"
                        Width="184" Height="128" Margin="0,0,12,12"
                        Command="{Binding SelectCommand}"
                        ToolTip.Tip="{Binding Name}">
                  <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <PathIcon Classes="deviceIcon" Data="{Binding Icon}" Width="30" Height="30"
                                HorizontalAlignment="Left" />
                      <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                              Background="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                              IsVisible="{Binding IsSelected}">
                        <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="White" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Classes="caption" Text="{Binding Subtitle}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Searching state -->
          <Border Classes="card" IsVisible="{Binding HasNoDevices}" Padding="20">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Width="64" Height="64" VerticalAlignment="Top" Margin="-4,-4,0,0">
                <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" />
                <Border Classes="iconBadge" Width="40" Height="40" CornerRadius="20">
                  <PathIcon Data="{StaticResource IconWifi}" />
                </Border>
              </Panel>
              <StackPanel Grid.Column="1" Margin="16,2,0,0" Spacing="4">
                <TextBlock Classes="h3" Text="{l:T 'Looking for nearby computers…'}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="{l:T 'Open Beam on the other computer. It will appear here automatically.'}" />
                <StackPanel IsVisible="{Binding ShowSearchHint}" Spacing="8" Margin="0,10,0,0">
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:T 'Still nothing? Make sure both computers are connected to the same Wi-Fi or network, and that Beam was allowed through Windows Firewall. You can also connect using the other computer\'s address.', Phone='Still nothing? Make sure the phone and the computer are on the same Wi-Fi, and that Beam was allowed through Windows Firewall on the computer. You can also connect using the computer\'s address.'}" />
                  <Button Content="{l:T 'Connect by address'}" Command="{Binding ConnectByAddressCommand}" />
                </StackPanel>
                <Button Classes="accent" Content="{l:T 'Scan the computer\'s code'}" Command="{Binding ScanCodeCommand}"
                        IsVisible="{Binding CanScanCodes}" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Step 2: files -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Files to send'}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasItems}">
              <Button Classes="subtle" Command="{Binding ChooseFilesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
                  <TextBlock Text="{l:T 'Add files'}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding ChooseFolderCommand}" IsVisible="{Binding IsDesktop}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
                  <TextBlock Text="{l:T 'Add folder'}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Content="{l:T 'Clear'}" Command="{Binding ClearCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowDropZone}">
              <Button Classes="subtle" Command="{Binding SendTextCommand}" ToolTip.Tip="{l:T 'Send a message or a link to the chosen computer'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconEdit}" Width="12" Height="12" />
                  <TextBlock Text="{l:T 'Send text or link'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Drop zone -->
          <Panel IsVisible="{Binding ShowDropZone}" MinHeight="180">
            <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource DropZoneStrokeBrush}"
                       StrokeThickness="1.5" StrokeDashArray="5,4" Fill="{DynamicResource CardBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
              <Border Classes="iconBadge" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconUpload}" Width="22" Height="22" />
              </Border>
              <TextBlock Classes="h3" Text="{l:T 'Drag files or folders here'}" HorizontalAlignment="Center" IsVisible="{Binding IsDesktop}" />
              <TextBlock Classes="caption" Text="{l:T 'or'}" HorizontalAlignment="Center" IsVisible="{Binding IsDesktop}" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Command="{Binding ChooseFilesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" />
                    <TextBlock Text="{l:T 'Choose files'}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding ChooseFolderCommand}" IsVisible="{Binding IsDesktop}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                    <TextBlock Text="{l:T 'Choose a folder'}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Panel>

          <!-- Text or a link shared to Beam from another app -->
          <Border Classes="card" Padding="16,12,10,12" IsVisible="{Binding HasSharedText}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="iconBadge" Width="34" Height="34" CornerRadius="8" VerticalAlignment="Top">
                <Panel>
                  <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16" IsVisible="{Binding SharedTextIsLink}" />
                  <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16" IsVisible="{Binding !SharedTextIsLink}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="caption" Text="{l:T 'Link to send'}" IsVisible="{Binding SharedTextIsLink}" />
                <TextBlock Classes="caption" Text="{l:T 'Text to send'}" IsVisible="{Binding !SharedTextIsLink}" />
                <TextBlock Text="{Binding SharedText}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Command="{Binding ClearSharedTextCommand}"
                      ToolTip.Tip="{l:T 'Remove from the list'}" VerticalAlignment="Top">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
            </Grid>
          </Border>

          <!-- Selected items -->
          <Border Classes="card" Padding="0" IsVisible="{Binding HasItems}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingItemViewModel">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10,10,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconBadge neutral" Width="34" Height="34" CornerRadius="8">
                          <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                          <TextBlock Classes="caption" Text="{Binding Details}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{l:T 'Remove from the list'}" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption" Text="{Binding ItemsSummary}" Margin="16,10" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Action bar -->
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="36,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
          <TextBlock Text="{Binding SendSummary}" TextTrimming="CharacterEllipsis"
                     Classes.secondary="{Binding !CanSend}" FontWeight="Normal" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowFreeLimits}">
            <TextBlock Classes="caption" Text="{Binding PlanText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Classes="link" Content="{l:T 'Upgrade'}" Command="{Binding UpgradeCommand}" Padding="0" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="accent large" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Send'}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
