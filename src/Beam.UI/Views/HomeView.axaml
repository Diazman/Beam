<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Beam.App.ViewModels"
             xmlns:views="using:Beam.App.Views"
             xmlns:l="using:Beam.App.Localization"
             x:Class="Beam.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <!-- Send: 1. what to send, 2. who to send it to, 3. Send. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Classes="page" Spacing="26" MaxWidth="880" HorizontalAlignment="Stretch">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="{l:T 'Send'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:T 'Send files straight to a nearby device. No cables, accounts or internet needed.'}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="chip nameChip" VerticalAlignment="Top" Margin="16,4,0,0"
                  Command="{Binding EditNameCommand}"
                  ToolTip.Tip="{Binding VisibilityText}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDiscoverable}" />
                <Ellipse Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding !IsDiscoverable}" />
              </Panel>
              <TextBlock Text="{Binding LocalDeviceName}" FontWeight="SemiBold" VerticalAlignment="Center"
                         MaxWidth="200" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <views:SettingsGear Grid.Column="2" />
        </Grid>

        <!-- A transfer running: how it goes, without leaving Send -->
        <Button Classes="row" Padding="0" Command="{Binding Main.ShowActivityCommand}" IsVisible="{Binding Main.HasCurrentTransfer}">
          <Border Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
              <Border Classes="iconBadge brand" Width="34" Height="34" CornerRadius="17" Grid.RowSpan="2">
                <PathIcon Data="{Binding Main.CurrentTransfer.Icon}" Width="14" Height="14" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Main.CurrentTransfer.ItemTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Main.CurrentTransfer.StatusText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Main.ActivitySummary}" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentTextBrush}" />
              <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,8,0,0" Maximum="100"
                           Value="{Binding Main.CurrentTransfer.Progress}" IsIndeterminate="{Binding Main.CurrentTransfer.IsIndeterminate}" />
            </Grid>
          </Border>
        </Button>

        <!-- 1. What -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="overline" Text="{l:T 'FILES'}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasItems}">
              <Button Classes="subtle" Command="{Binding ChooseFilesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
                  <TextBlock Text="{l:T 'Add files'}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding ChooseFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" />
                  <TextBlock Text="{l:T 'Add folder'}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Content="{l:T 'Clear'}" Command="{Binding ClearCommand}" />
            </StackPanel>
          </Grid>

          <!-- Drop zone: the first thing to do -->
          <Panel IsVisible="{Binding ShowDropZone}" MinHeight="210">
            <Rectangle RadiusX="20" RadiusY="20" Stroke="{DynamicResource DropZoneStrokeBrush}"
                       StrokeThickness="1.5" StrokeDashArray="6,5" Fill="{DynamicResource CardBrush}" />
            <Rectangle RadiusX="20" RadiusY="20" Fill="{DynamicResource AccentWashBrush}" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
              <Border Classes="iconBadge brand" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconUpload}" Width="24" Height="24" />
              </Border>
              <TextBlock Classes="h2" Text="{l:T 'Drop files or folders here'}" HorizontalAlignment="Center" IsVisible="{Binding IsDesktop}" />
              <TextBlock Classes="h2" Text="{l:T 'Choose what to send'}" HorizontalAlignment="Center" IsVisible="{Binding !IsDesktop}" />
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding ChooseFilesCommand}" Margin="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" />
                    <TextBlock Text="{l:T 'Choose files'}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding ChooseFolderCommand}" Margin="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                    <TextBlock Text="{l:T 'Choose a folder'}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding SendTextCommand}" Margin="4" ToolTip.Tip="{l:T 'Send a message or a link to the chosen device'}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" />
                    <TextBlock Text="{l:T 'Send text or link'}" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Panel>

          <!-- Text or a link shared to Beam from another app -->
          <Border Classes="card" Padding="16,12,10,12" IsVisible="{Binding HasSharedText}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="iconBadge" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top">
                <Panel>
                  <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16" IsVisible="{Binding SharedTextIsLink}" />
                  <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16" IsVisible="{Binding !SharedTextIsLink}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="caption" Text="{l:T 'Link to send'}" IsVisible="{Binding SharedTextIsLink}" />
                <TextBlock Classes="caption" Text="{l:T 'Text to send'}" IsVisible="{Binding !SharedTextIsLink}" />
                <TextBlock Text="{Binding SharedText}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Command="{Binding ClearSharedTextCommand}"
                      AutomationProperties.Name="{l:T 'Remove from the list'}" ToolTip.Tip="{l:T 'Remove from the list'}" VerticalAlignment="Top">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
            </Grid>
          </Border>

          <!-- Chosen files -->
          <Border Classes="card" Padding="0" IsVisible="{Binding HasItems}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingItemViewModel">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10,10,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconBadge neutral" Width="36" Height="36" CornerRadius="10">
                          <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                          <TextBlock Classes="caption" Text="{Binding Details}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}"
                                AutomationProperties.Name="{l:T 'Remove from the list'}" ToolTip.Tip="{l:T 'Remove from the list'}" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" Margin="16,8,8,8">
                <TextBlock Classes="caption" Text="{Binding ItemsSummary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="subtle" Command="{Binding SendTextCommand}" ToolTip.Tip="{l:T 'Send a message or a link to the chosen device'}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconEdit}" Width="12" Height="12" />
                    <TextBlock Text="{l:T 'Send text or link'}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2. Who -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Classes="overline" Text="{l:T 'TO'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="{l:T 'Can\'t find a device?'}"
                    Command="{Binding ConnectByAddressCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding ScanCodeCommand}" IsVisible="{Binding CanScanCodes}"
                    AutomationProperties.Name="{l:T 'Scan a computer\'s code to pair with it'}" ToolTip.Tip="{l:T 'Scan a computer\'s code to pair with it'}" Margin="4,0,0,0">
              <PathIcon Data="{StaticResource IconQr}" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{l:T 'Look for nearby devices again'}" ToolTip.Tip="{l:T 'Look for nearby devices again'}" Margin="4,0,0,0">
              <PathIcon Data="{StaticResource IconRefresh}" />
            </Button>
          </Grid>

          <TextBlock Classes="caption" Text="{Binding DeviceHint}" IsVisible="{Binding HasDeviceHint}" Margin="0,-4,0,0" />

          <Border Classes="notice" IsVisible="{Binding HasBluetoothNotice}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding BluetoothNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="{l:T 'Allow'}" Command="{Binding AllowBluetoothCommand}"
                      IsVisible="{Binding BluetoothNeedsPermission}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
          </Border>

          <Border Classes="notice warning" IsVisible="{Binding DiscoveryUnavailable}">
            <TextBlock Text="{Binding DiscoveryProblem}" TextWrapping="Wrap" />
          </Border>

          <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding HasDevices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceViewModel">
                <Button Classes="device" Classes.selected="{Binding IsSelected}"
                        Width="262" Height="76" Margin="0,0,12,12"
                        Command="{Binding SelectCommand}"
                        ToolTip.Tip="{Binding Name}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Classes="deviceIcon" Data="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,6,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource AccentGradientBrush}" IsVisible="{Binding IsSelected}">
                      <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="White" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- A trusted device is chosen: browse its shared folders -->
          <Button Classes="link" Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}" HorizontalAlignment="Left" Margin="-6,-8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
              <TextBlock Text="{Binding BrowseText}" />
            </StackPanel>
          </Button>

          <!-- Searching -->
          <Border Classes="card" IsVisible="{Binding HasNoDevices}" Padding="20">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Width="56" Height="56" VerticalAlignment="Top">
                <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" />
                <Border Classes="iconBadge brand" Width="40" Height="40" CornerRadius="20">
                  <PathIcon Data="{StaticResource IconDevices}" />
                </Border>
              </Panel>
              <StackPanel Grid.Column="1" Margin="14,4,0,0" Spacing="4">
                <TextBlock Classes="h3" Text="{l:T 'Looking for nearby devices…'}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="{l:T 'Open Beam on the other device. It appears here by itself.'}" />
                <StackPanel IsVisible="{Binding ShowSearchHint}" Spacing="8" Margin="0,10,0,0">
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:T 'Still nothing? Make sure both computers are connected to the same Wi-Fi or network, and that Beam was allowed through Windows Firewall. You can also connect using the other computer\'s address.', Phone='Still nothing? Make sure the phone and the computer are on the same Wi-Fi, and that Beam was allowed through Windows Firewall on the computer. You can also connect using the computer\'s address.'}" />
                  <Button Content="{l:T 'Connect by address'}" Command="{Binding ConnectByAddressCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Classes="accent" Content="{l:T 'Scan the computer\'s code'}" Command="{Binding ScanCodeCommand}"
                        IsVisible="{Binding CanScanCodes}" Margin="0,10,0,0" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Classes="caption" Text="{Binding DiscoveryStatus}" IsVisible="{Binding HasDiscoveryStatus}" TextWrapping="Wrap" />

          <!-- Sending directly is chosen in Settings → Connection; said here so it's never a surprise. -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ShowsDirectNote}">
            <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14" Foreground="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{l:T 'Sending directly: the chosen devices connect to this one, without the Wi-Fi router.'}" />
            <Button Grid.Column="2" Classes="link" Content="{l:T 'Change'}" Command="{Binding OpenConnectionSettingsCommand}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 3. Send -->
    <Border Grid.Row="1" Classes="actionBar">
      <Grid ColumnDefinitions="*,Auto" MaxWidth="880" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding SendSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"
                   Classes.secondary="{Binding !CanSend}" />
        <Button Grid.Column="1" Classes="accent large" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Send'}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
