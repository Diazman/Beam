<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             x:Class="Beam.App.Views.PhoneView"
             x:DataType="vm:PhoneViewModel">
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="24" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{l:T 'Phone'}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{l:T 'Send files between this computer and any phone or tablet — iPhone or Android. No app to install: the phone uses its web browser.'}" />
      </StackPanel>

      <Border Classes="notice error" IsVisible="{Binding HasProblem}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
      </Border>

      <!-- Off -->
      <Border Classes="card" IsVisible="{Binding IsOff}" Padding="24">
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="iconBadge" Width="56" Height="56" CornerRadius="28" VerticalAlignment="Top">
            <PathIcon Data="{StaticResource IconPhone}" Width="24" Height="24" />
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="8">
            <TextBlock Classes="h3" Text="{l:T 'Connect a phone'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:T 'Make sure the phone is on the same Wi-Fi as this computer. Beam will show a code to scan with the phone\'s camera.'}" />
            <Button Classes="accent large" Content="{l:T 'Show the code'}" Command="{Binding TurnOnCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsDirectStarting}" Padding="20">
        <TextBlock Text="{l:T 'Starting the direct connection…'}" />
      </Border>
      <Border Classes="card" IsVisible="{Binding IsDirect}" Padding="24">
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="White" CornerRadius="12" Padding="14" VerticalAlignment="Top">
            <Path Data="{Binding WifiQr}" Fill="Black" Stretch="Uniform" Width="168" Height="168" />
          </Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8">
            <TextBlock Classes="h3" Text="{l:T 'First, join this computer\'s Wi-Fi'}" TextWrapping="Wrap" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:T 'Scan this code with the phone\'s camera and tap Join. Then scan the code below to open Beam.'}" />
            <TextBlock Classes="caption" Text="{l:T 'Or join it in the phone\'s Wi-Fi settings:'}" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="caption" Text="{l:T 'Network:'}" VerticalAlignment="Center" />
              <SelectableTextBlock Text="{Binding DirectNetworkName}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="caption" Text="{l:T 'Password:'}" VerticalAlignment="Center" />
              <SelectableTextBlock Text="{Binding DirectPassword}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsWaitingForDirectAddress}"
                       Text="{l:T 'Getting the address on this computer\'s Wi-Fi ready…'}" />
            <Button Content="{l:T 'Use the normal Wi-Fi instead'}" Command="{Binding StopDirectCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- On -->
      <Border Classes="card" IsVisible="{Binding IsOn}" Padding="24">
        <Grid ColumnDefinitions="Auto,*">
          <!-- Always black on white (phone cameras need the contrast, also in dark mode). -->
          <Border Background="White" CornerRadius="12" Padding="16" VerticalAlignment="Top">
            <Path Data="{Binding Qr}" Fill="Black" Stretch="Uniform" Width="240" Height="240" />
          </Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="10">
            <TextBlock Classes="h3" Text="{l:T 'Scan with your phone\'s camera'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap">
              <Run Text="{l:T '1. Open the camera and point it at the code, then tap the link.'}" />
              <LineBreak />
              <Run Text="{l:T '2. On the page that opens, choose files to send here, or download what you share below.'}" />
              <LineBreak />
              <Run Text="{l:T 'Have the Beam app on your phone? Scan this code in the app (Scan code) to pair them: then they find each other by themselves, even without Wi-Fi.'}" />
            </TextBlock>
            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                       Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />
              <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="caption" Text="{l:T 'Or type this address in the phone\'s browser:'}" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SelectableTextBlock Text="{Binding Link}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
              <Button Classes="link" Content="{l:T 'Copy'}" Command="{Binding CopyLinkCommand}" VerticalAlignment="Center" />
              <TextBlock Classes="caption success" Text="{Binding CopyStatus}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding OtherLinks}" IsVisible="{Binding HasOtherLinks}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{l:T 'Only someone with this code can connect, and files from the phone still need your OK. The code changes every time and stops working when you turn it off. Use it on networks you trust: unlike transfers between computers, phone transfers aren\'t encrypted.'}" />
            <Button Content="{l:T 'Turn off'}" Command="{Binding TurnOffCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- No shared Wi-Fi (or an iPhone): this computer makes its own Wi-Fi with Wi-Fi Direct -->
      <Border Classes="card" IsVisible="{Binding OffersDirect}" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{l:T 'No Wi-Fi network? Connect directly'}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'This computer makes its own Wi-Fi for the phone: works with iPhone and Android, anywhere. The phone has no internet while it\'s connected to it.'}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{l:T 'Connect directly'}" Command="{Binding ConnectDirectlyCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <!-- Share -->
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{l:T 'Send to your phone'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding SharedSummary}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ShareFilesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" />
                  <TextBlock Text="{l:T 'Share files'}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ShareFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                  <TextBlock Text="{l:T 'Share a folder'}" />
                </StackPanel>
              </Button>
              <Button Classes="link" Content="{l:T 'Stop sharing'}" Command="{Binding StopSharingCommand}" IsVisible="{Binding IsSharing}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'Files from the phone are saved to the same folder as files from other computers (see Settings).'}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
