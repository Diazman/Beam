<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             x:Class="Beam.App.Views.PhoneView"
             x:DataType="vm:PhoneViewModel">
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="24" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{l:T 'Phone'}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{l:T 'Send files between this computer and a phone: with the Beam app, or with any phone\'s web browser.'}" />
      </StackPanel>

      <Border Classes="notice error" IsVisible="{Binding HasProblem}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
      </Border>

      <!-- The Beam app: one code pairs and connects (also without a shared Wi-Fi) -->
      <Border Classes="card" IsVisible="{Binding ShowsAppCode}" Padding="24">
        <Grid ColumnDefinitions="Auto,*">
          <!-- Always black on white (phone cameras need the contrast, also in dark mode). -->
          <Border Background="White" CornerRadius="12" Padding="16" VerticalAlignment="Top">
            <Path Data="{Binding AppQr}" Fill="Black" Stretch="Uniform" Width="240" Height="240" />
          </Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="10">
            <TextBlock Classes="h3" Text="{l:T 'Scan this code with the Beam app'}" TextWrapping="Wrap" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding AppCodeText}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsHostingStarting}"
                       Text="{l:T 'Getting this computer\'s own Wi-Fi ready…'}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding AppCodeConnectsDirectly}"
                       Text="{l:T 'The phone has no internet while it\'s connected to this computer\'s Wi-Fi.'}" />
            <Button Classes="accent" Content="{l:T 'Don\'t have the Beam app? Connect with the browser'}" Command="{Binding ShowBrowserCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Any phone: Beam's page in the browser, over the shared Wi-Fi -->
      <Border Classes="card" IsVisible="{Binding ShowsBrowserCode}" Padding="24">
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="White" CornerRadius="12" Padding="16" VerticalAlignment="Top">
            <Path Data="{Binding Qr}" Fill="Black" Stretch="Uniform" Width="240" Height="240" />
          </Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="10">
            <TextBlock Classes="h3" Text="{l:T 'Scan with your phone\'s camera'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap">
              <Run Text="{l:T '1. Open the camera and point it at the code, then tap the link.'}" />
              <LineBreak />
              <Run Text="{l:T '2. On the page that opens, choose files to send here, or download what you share below.'}" />
            </TextBlock>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'The phone needs to be on the same Wi-Fi as this computer.'}" />
            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                       Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />
              <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="caption" Text="{l:T 'Or type this address in the phone\'s browser:'}" Margin="0,6,0,0" />
            <SelectableTextBlock Text="{Binding Link}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="link" Content="{l:T 'Copy'}" Command="{Binding CopyLinkCommand}" Padding="0" />
              <TextBlock Classes="caption success" Text="{Binding CopyStatus}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding OtherLinks}" IsVisible="{Binding HasOtherLinks}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{l:T 'Only someone with this code can connect, and files from the phone still need your OK. The code changes every time and stops working when you turn it off. Use it on networks you trust: unlike transfers between Beam apps, browser transfers aren\'t encrypted.'}" />
            <Button Content="{l:T 'Back to the Beam app code'}" Command="{Binding ShowAppCodeCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Share with the phone's browser -->
      <StackPanel Spacing="10" IsVisible="{Binding ShowsBrowserCode}">
        <TextBlock Classes="h2" Text="{l:T 'Send to your phone'}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding SharedSummary}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ShareFilesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" />
                  <TextBlock Text="{l:T 'Share files'}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ShareFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                  <TextBlock Text="{l:T 'Share a folder'}" />
                </StackPanel>
              </Button>
              <Button Classes="link" Content="{l:T 'Stop sharing'}" Command="{Binding StopSharingCommand}" IsVisible="{Binding IsSharing}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:T 'Files from the phone are saved to the same folder as files from other devices (see Settings).'}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
