<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             x:Class="Beam.App.Views.MobileView"
             x:DataType="vm:MainViewModel"
             Classes="compact"
             Background="{DynamicResource WindowBackgroundBrush}">
  <!-- The phone layout: one page at a time with a bottom navigation bar. The desktop uses MainWindow. -->
  <Panel>
    <Grid RowDefinitions="*,Auto">
      <DockPanel>
        <!-- Someone is browsing this device: who, and Stop -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Visits}" IsVisible="{Binding HasVisits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowseVisitViewModel">
              <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0" />
                  <Button Grid.Column="2" Content="{l:T 'Stop'}" Command="{Binding StopCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding CurrentPage}" />
      </DockPanel>

      <Border Grid.Row="1" Classes="bottomBar">
        <UniformGrid Rows="1">
          <RadioButton Classes="tab" GroupName="tabs" Content="{l:T 'Send'}"
                       Tag="{StaticResource IconSend}" IsChecked="{Binding IsHomePage}" />
          <RadioButton Classes="tab" GroupName="tabs" Content="{l:T 'Receive'}"
                       Tag="{StaticResource IconDownload}" IsChecked="{Binding IsReceivePage}" />
          <RadioButton Classes="tab" GroupName="tabs" Content="{l:T 'Transfers'}"
                       Tag="{StaticResource IconUpload}" IsChecked="{Binding IsTransfersPage}" />
          <RadioButton Classes="tab" GroupName="tabs" Content="{l:T 'Settings'}"
                       Tag="{StaticResource IconSettings}" IsChecked="{Binding IsSettingsPage}" />
        </UniformGrid>
      </Border>
    </Grid>

    <!-- Dialogs: full width on a phone. -->
    <Border IsVisible="{Binding HasDialog}" Background="{DynamicResource OverlayBrush}">
      <ScrollViewer VerticalAlignment="Center">
        <Border Classes="dialog" Margin="12">
          <ContentControl Content="{Binding Dialog}" />
        </Border>
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
