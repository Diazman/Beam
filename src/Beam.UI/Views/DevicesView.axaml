<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             x:Class="Beam.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">
  <!-- Devices: everything about other devices in one place. -->
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="22" MaxWidth="880" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{l:T 'Devices'}" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="{l:T 'Devices nearby, and the ones you trust. Trusted devices send each other files without asking and can browse each other\'s shared folders.'}" />
        </StackPanel>
      </Grid>

      <WrapPanel Orientation="Horizontal">
        <Button Classes="accent" Command="{Binding AddTrustedCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconShield}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Add a trusted device'}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ScanCodeCommand}" IsVisible="{Binding CanScanCodes}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconQr}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Scan a code'}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ConnectByAddressCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Connect by address'}" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- No device yet -->
      <Border Classes="card" Padding="22" IsVisible="{Binding HasNoRows}">
        <Grid ColumnDefinitions="Auto,*">
          <Panel Width="56" Height="56" VerticalAlignment="Top">
            <Ellipse Classes="pulse" Fill="{DynamicResource AccentBrush}" />
            <Border Classes="iconBadge brand" Width="40" Height="40" CornerRadius="20">
              <PathIcon Data="{StaticResource IconDevices}" />
            </Border>
          </Panel>
          <StackPanel Grid.Column="1" Margin="14,4,0,0" Spacing="4">
            <TextBlock Classes="h3" Text="{l:T 'Looking for nearby devices…'}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:T 'Open Beam on the other device. It appears here by itself when it\'s on the same Wi-Fi or nearby.'}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- The devices -->
      <Border Classes="card" Padding="0" IsVisible="{Binding HasRows}">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceRowViewModel">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="iconBadge neutral" Width="42" Height="42" CornerRadius="12">
                    <PathIcon Data="{Binding Icon}" Width="20" Height="20" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Classes="badge" IsVisible="{Binding IsTrusted}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource IconShield}" Width="10" Height="10" Foreground="{DynamicResource AccentTextBrush}" />
                          <TextBlock Text="{l:T 'Trusted'}" FontSize="11" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}" ToolTip.Tip="{l:T 'Browse its shared folders'}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                        <TextBlock Text="{l:T 'Browse'}" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding SendCommand}" IsVisible="{Binding IsNearby}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconSend}" Width="13" Height="13" />
                        <TextBlock Text="{l:T 'Send'}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="icon" IsVisible="{Binding HasMore}" AutomationProperties.Name="{l:T 'More'}" ToolTip.Tip="{l:T 'More'}">
                      <PathIcon Data="{StaticResource IconChevronDown}" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{l:T 'Ask before browsing again'}" Command="{Binding Trusted.AskAgainCommand}"
                                    IsVisible="{Binding AlwaysBrowse}" />
                          <MenuItem Header="{Binding Trusted.StopTrustingText}" Command="{Binding Trusted.RemoveCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Devices without Beam: a web page on the shared Wi-Fi (computers) -->
      <Button Classes="row" Command="{Binding OpenWebShareCommand}" IsVisible="{Binding CanShareWithBrowser}" Padding="0">
        <Border Classes="card" Padding="18,16">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="iconBadge" Width="42" Height="42" CornerRadius="12">
              <PathIcon Data="{StaticResource IconGlobe}" Width="20" Height="20" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{l:T 'No Beam app on the other device?'}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:T 'Share files with any phone, tablet or computer through its web browser.'}" />
            </StackPanel>
            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="18" Height="18"
                      Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
