<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:vm="using:Beam.App.ViewModels"
             xmlns:views="using:Beam.App.Views"
             x:Class="Beam.App.Views.TransfersView"
             x:DataType="vm:TransfersPage">
  <!-- Phones: running transfers on top, then the history, in one tab. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,22,12,12">
      <TextBlock Classes="h1" Text="{l:T 'Transfers'}" VerticalAlignment="Center" />
    </Grid>
    <Panel>
      <StackPanel Spacing="6" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top"
                  IsVisible="{Binding IsEmpty}">
        <TextBlock Classes="h3" Text="{l:T 'No transfers yet'}" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:T 'Files you send or receive will be listed here.'}" />
      </StackPanel>
      <ScrollViewer>
        <StackPanel Spacing="10" Margin="12,0,12,12">
          <ItemsControl ItemsSource="{Binding Main.Transfers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TransferViewModel">
                <!-- Finished ones that went fine are in the history below; the rest stay (e.g. to retry). -->
                <Panel IsVisible="{Binding !IsSuccess}">
                  <views:TransferCard IsVisible="{Binding !IsNeutral}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,Auto" Margin="6,8,0,0" IsVisible="{Binding Main.History.HasItems}">
            <TextBlock Classes="h2" Text="{l:T 'History'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="{l:T 'Clear history'}" Command="{Binding Main.History.ClearCommand}" />
          </Grid>
          <Border Classes="card" Padding="0" IsVisible="{Binding Main.History.HasItems}">
            <ItemsControl ItemsSource="{Binding Main.History.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <views:HistoryRow />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
