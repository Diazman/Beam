<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Beam.App.Localization">

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <!-- Type scale: display 34 · h1 28 · dialog 21 · h2 17 · h3 14 · body 14 · caption 12 -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A small label above a group ("NEARBY DEVICES"). -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <!-- Text in the brand gradient (the selected destination, key numbers). -->
  <Style Selector="TextBlock.gradient">
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientHorizontalBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <!-- A kind of document, indented under its "Documents" checkbox (backup choices). -->
  <Style Selector="CheckBox.child">
    <Setter Property="Margin" Value="24,0,0,0" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <!-- A card that stands out: the main thing on a page (Receive's status, the drop zone). -->
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="28" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="BoxShadow" Value="0 24 64 0 #59000000" />
  </Style>
  <!-- The logo tile: the brand gradient with the paper plane. -->
  <Style Selector="Border.logo">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>
  <!-- A small label next to an item ("New" folders in backup choices). -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Border.iconBadge">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <!-- The brand-gradient circle around a main icon (Receive, the drop zone, a selected device). -->
  <Style Selector="Border.iconBadge.brand">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.brand > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Border.iconBadge > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Border.iconBadge.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.success > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.warning > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.error > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.neutral">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>
  <Style Selector="Border.iconBadge.neutral > PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,11" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.details">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.large">
    <Setter Property="Padding" Value="26,12" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <!-- Primary action: the brand gradient. One per screen. -->
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.accent:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
  </Style>

  <!-- A full-width row in a list (Browse: a file or folder) -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>

  <!-- Device cards -->
  <Style Selector="Button.device">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.device:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.device:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>
  <Style Selector="Button.device.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.device PathIcon.deviceIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.device.selected PathIcon.deviceIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}" />
  </Style>

  <!-- Page margins; the phone layout (MobileView, class "compact") uses less space and wraps more. -->
  <!-- Page margins and width: content keeps a readable width on wide windows. -->
  <Style Selector=":is(Control).page">
    <Setter Property="Margin" Value="40,34,40,28" />
  </Style>
  <Style Selector=".compact :is(Control).page">
    <Setter Property="Margin" Value="16,20,16,16" />
  </Style>
  <Style Selector=".compact Button.nameChip">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBox.nameBox">
    <Setter Property="Width" Value="320" />
  </Style>
  <Style Selector=".compact TextBox.nameBox">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector=".compact Grid.settingRow TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=".compact TextBlock.caption">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Dialog widths on the desktop; on a phone dialogs use the screen width. -->
  <Style Selector="UserControl.w420"><Setter Property="Width" Value="420" /></Style>
  <Style Selector="UserControl.w460"><Setter Property="Width" Value="460" /></Style>
  <Style Selector="UserControl.w480"><Setter Property="Width" Value="480" /></Style>
  <Style Selector="UserControl.w500"><Setter Property="Width" Value="500" /></Style>
  <Style Selector=".compact UserControl.dialogBody"><Setter Property="Width" Value="NaN" /></Style>
  <Style Selector=".compact UserControl.dialogBody TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <!-- Phones always save to Downloads/Beam. -->
  <Style Selector=".compact Button.changeFolder"><Setter Property="IsVisible" Value="False" /></Style>

  <!-- Phone layout: bottom navigation bar -->
  <Style Selector="Border.bottomBar">
    <Setter Property="Background" Value="{DynamicResource RailBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="4,6,4,8" />
  </Style>
  <Style Selector="RadioButton.tab">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="12" Padding="2,8,2,6">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <Border Name="pill" CornerRadius="14" Padding="14,3" HorizontalAlignment="Center">
              <PathIcon Name="icon" Data="{TemplateBinding Tag}" Width="20" Height="20"
                        Foreground="{DynamicResource TextTertiaryBrush}" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#pill">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ PathIcon#icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Navigation rail (desktop): icon over label; the current one in the brand gradient on a soft pill. -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="14" Padding="2,10,2,8" Width="76">
          <StackPanel Spacing="5" HorizontalAlignment="Center">
            <PathIcon Name="icon" Data="{TemplateBinding Tag}" Width="20" Height="20"
                      Foreground="{DynamicResource TextTertiaryBrush}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ PathIcon#icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A count on a navigation item (transfers running). -->
  <Style Selector="Border.navBadge">
    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.navBadge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Section list in Settings: one row per section, the open one highlighted. -->
  <Style Selector="RadioButton.section">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="10" Padding="12,9">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Name="icon" Data="{TemplateBinding Tag}" Width="16" Height="16"
                      Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.section:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.section:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="RadioButton.section:checked /template/ PathIcon#icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientBrush}" />
  </Style>
  <Style Selector="RadioButton.section:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Switch labels (Avalonia's own are English) -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{l:T 'On'}" />
    <Setter Property="OffContent" Value="{l:T 'Off'}" />
  </Style>

  <!-- Progress -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource AccentGradientHorizontalBrush}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>
  <Style Selector="ProgressBar.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- Searching pulse -->
  <Style Selector="Ellipse.pulse">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Width" Value="34" />
          <Setter Property="Height" Value="34" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Width" Value="64" />
          <Setter Property="Height" Value="64" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Expanders: plain, for "more options" (progressive disclosure). -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,4,18,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Pages fade in when shown. -->
  <Style Selector="ContentControl.pageHost > ContentPresenter > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Phones: the Settings gear in the header of the main pages (the desktop has Settings in the rail). -->
  <Style Selector=":is(UserControl).settingsGear">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="8,-4,-8,0" />
  </Style>
  <Style Selector=".compact :is(UserControl).settingsGear">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- The bar at the bottom of a page with its main action (Send). -->
  <Style Selector="Border.actionBar">
    <Setter Property="Background" Value="{DynamicResource RailBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="40,14" />
  </Style>
  <Style Selector=".compact Border.actionBar">
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <!-- Receive: a wider, slower pulse around the ready sign. -->
  <Style Selector="Ellipse.pulseLarge">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Animations>
      <Animation Duration="0:0:2.6" IterationCount="INFINITE" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Width" Value="72" />
          <Setter Property="Height" Value="72" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Width" Value="120" />
          <Setter Property="Height" Value="120" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Settings: the list of sections beside the open one (desktop); the whole screen on phones. -->
  <Style Selector="ScrollViewer.sectionList">
    <Setter Property="Width" Value="288" />
  </Style>
  <!-- On the desktop the list stands on the page; on phones it is a card like the rest. -->
  <Style Selector="Border.sectionCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=".compact Border.sectionCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector=".compact RadioButton.section">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector=".compact ScrollViewer.sectionList">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>

  <!-- Settings rows -->
  <Style Selector="Grid.settingRow">
    <Setter Property="MinHeight" Value="44" />
  </Style>
</Styles>
