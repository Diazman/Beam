<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Beam for iPhone and iPad: the shared Beam.UI screens (phone layout, MobileView) on a single-view Avalonia host.
    Build (on a Mac with Xcode): dotnet publish src/Beam.iOS -c Release -f net10.0-ios -r ios-arm64
    iOS doesn't let apps start a Wi-Fi network: Direct sends join the computer's network instead (it hosts for them).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>Beam.iOS</RootNamespace>
    <AssemblyName>Beam.iOS</AssemblyName>
    <ApplicationId>com.diazman.beam</ApplicationId>
    <ApplicationTitle>Beam</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
    <ProjectReference Include="..\Beam.UI\Beam.UI.csproj" />
  </ItemGroup>

</Project>
