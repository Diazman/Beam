<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) layout: self-contained app folder that packaging/build-msix.ps1 packs.
  Usage: dotnet publish src/Beam.App -p:PublishProfile=msix-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Partial trimming removes unused framework/Avalonia code (~200 MB -> ~30 MB). Beam's own code is trim-safe
         (source-generated JSON, compiled XAML bindings). Remaining IL2026/IL2104 warnings come from Avalonia's
         IDE designer support, which is never used at runtime. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Precompiled code for fast startup. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\msix-layout\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
