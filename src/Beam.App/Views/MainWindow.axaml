<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Beam.App.Localization"
        xmlns:vm="using:Beam.App.ViewModels"
        xmlns:views="using:Beam.App.Views"
        x:Class="Beam.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Beam"
        Icon="/Assets/beam.ico"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        DragDrop.AllowDrop="True">


  <Panel>
    <Grid ColumnDefinitions="Auto,*">
      <!-- Navigation: the four destinations, Settings apart at the bottom -->
      <Border Width="92"
              Background="{DynamicResource RailBackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="0,20,0,16">
          <Image DockPanel.Dock="Top" Source="avares://Beam.UI/Assets/beam.png" Width="40" Height="40" HorizontalAlignment="Center"
                 Margin="0,0,0,22" ToolTip.Tip="Beam" />
          <RadioButton DockPanel.Dock="Bottom" Classes="nav" GroupName="nav" Content="{l:T 'Settings'}" HorizontalAlignment="Center"
                       Tag="{StaticResource IconSettings}" IsChecked="{Binding IsSettingsPage}" />
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <RadioButton Classes="nav" GroupName="nav" Content="{l:T 'Send'}"
                         Tag="{StaticResource IconSend}" IsChecked="{Binding IsHomePage}" />
            <RadioButton Classes="nav" GroupName="nav" Content="{l:T 'Receive'}"
                         Tag="{StaticResource IconDownload}" IsChecked="{Binding IsReceivePage}" />
            <RadioButton Classes="nav" GroupName="nav" Content="{l:T 'Devices'}"
                         Tag="{StaticResource IconDevices}" IsChecked="{Binding IsDevicesPage}" />
            <Panel>
              <RadioButton Classes="nav" GroupName="nav" Content="{l:T 'Activity'}"
                           Tag="{StaticResource IconActivity}" IsChecked="{Binding IsActivityPage}" />
              <Border Classes="navBadge" Margin="0,4,12,0" IsVisible="{Binding HasActiveTransfers}">
                <TextBlock Text="{Binding ActiveTransferBadge}" />
              </Border>
            </Panel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Current page; someone browsing this device shows above it, with Stop -->
      <DockPanel Grid.Column="1">
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Visits}" IsVisible="{Binding HasVisits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowseVisitViewModel">
              <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,9">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0" />
                  <Button Grid.Column="2" Content="{l:T 'Stop'}" Command="{Binding StopCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Classes="pageHost" Content="{Binding CurrentPage}" />
      </DockPanel>
    </Grid>

    <!-- Shown while files are dragged over the window -->
    <Border IsVisible="{Binding IsDragOver}" Background="{DynamicResource OverlayBrush}" IsHitTestVisible="False">
      <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,32">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Classes="iconBadge" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,6">
            <PathIcon Data="{StaticResource IconUpload}" Width="26" Height="26" />
          </Border>
          <TextBlock Classes="h2" Text="{l:T 'Drop to add to your send list'}" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{l:T 'Files and whole folders both work.'}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Dialogs -->
    <Border IsVisible="{Binding HasDialog}" Background="{DynamicResource OverlayBrush}">
      <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="560" Margin="24">
        <ContentControl Content="{Binding Dialog}" />
      </Border>
    </Border>
  </Panel>
</Window>
