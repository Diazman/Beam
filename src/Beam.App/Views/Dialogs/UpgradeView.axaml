<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.UpgradeView"
             x:DataType="dlg:UpgradeViewModel"
             Width="500">
  <StackPanel Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="/Assets/beam.png" Width="40" Height="40" VerticalAlignment="Center" />
      <TextBlock Classes="dialogTitle" Text="{Binding Title}" VerticalAlignment="Center" />
    </StackPanel>

    <Border Classes="notice warning" IsVisible="{Binding HasReason}">
      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
    </Border>

    <ItemsControl ItemsSource="{Binding Benefits}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="dlg:ProBenefit">
          <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <Border Classes="iconBadge success" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top">
              <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,1,0,0" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="caption" Text="{Binding Footnote}" TextWrapping="Wrap" />
    <TextBlock Classes="caption error" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Not now" MinWidth="96" Command="{Binding NotNowCommand}" />
      <Button Classes="accent" Content="{Binding BuyText}" MinWidth="120" Command="{Binding BuyCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
