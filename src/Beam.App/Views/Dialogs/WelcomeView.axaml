<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Beam.App.Localization"
             xmlns:dlg="using:Beam.App.ViewModels.Dialogs"
             x:Class="Beam.App.Views.Dialogs.WelcomeView"
             x:DataType="dlg:WelcomeViewModel"
             Width="480">
  <StackPanel Spacing="18">
    <Image Source="/Assets/beam.png" Width="64" Height="64" HorizontalAlignment="Left" />
    <StackPanel Spacing="8">
      <TextBlock Classes="dialogTitle" FontSize="24" Text="{l:T 'Welcome to Beam'}" />
      <TextBlock Classes="secondary" FontSize="15" TextWrapping="Wrap"
                 Text="{l:T 'Send files directly between nearby computers. Open Beam on both computers, pick one, and drop in your files.'}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="h3" Text="{l:T 'Name this computer'}" />
      <TextBox Name="NameBox" Text="{Binding DeviceName}" MaxLength="{Binding MaxNameLength}" Watermark="{l:T 'e.g. Diaz\'s PC'}" />
      <TextBlock Classes="caption" Text="{l:T 'This is the name other people see. You can change it later in Settings.'}" />
    </StackPanel>

    <Border Classes="notice" IsVisible="{Binding ShowFirewallNote}">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="13"
                   Text="{l:T 'Windows may ask whether Beam can use your network. Choose Allow so nearby computers can find this one. Beam never needs administrator rights.'}" />
      </Grid>
    </Border>

    <Button Classes="accent large" Content="{l:T 'Get started'}" HorizontalAlignment="Right" Command="{Binding StartCommand}" IsDefault="True" />
  </StackPanel>
</UserControl>
