<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Beam for Android: the shared Beam.UI screens (phone layout, MobileView) on a single-view Avalonia host.
    Build: dotnet build src/Beam.Android -c Release   (needs .NET 10 and: dotnet workload install android)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Beam.Droid</RootNamespace>
    <AssemblyName>Beam.Android</AssemblyName>
    <ApplicationId>com.diazman.beam</ApplicationId>
    <ApplicationTitle>Beam</ApplicationTitle>
    <!-- Play needs an increasing integer: 1.2.1 -> 10201. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)))), $([System.Version]::Parse('$(Version)').Build)))</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
    <ProjectReference Include="..\Beam.UI\Beam.UI.csproj" />
  </ItemGroup>

</Project>
